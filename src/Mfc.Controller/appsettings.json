{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Mfc": {
    "Grpc": {
      "ListenAddress": "https://127.0.0.1:5101",
      "ShutdownTimeoutSeconds": 30,
      "AllowInsecureLoopback": false
    },
    "Security": {
      "RequireTls": true,
      "MasterKeyProvider": ""
    },
    "Authentication": {
      "AllowDevelopmentAuthentication": false
    },
    "Database": {
      "ConnectionString": ""
    },
    "RouterOs": {
      "Enabled": false,
      "ProbeTimeoutSeconds": 30
    },
    "OperationalJobs": {
      "Enabled": true,
      "RecoveryEnabled": true,
      "MaxQueueDepth": 256,
      "MaxCaptureConcurrency": 16,
      "MaxWriteConcurrency": 8,
      "DriftPollIntervalSeconds": 300,
      "LockHeartbeatIntervalSeconds": 30,
      "CleanupIntervalSeconds": 600,
      "ExpiredExceptionIntervalSeconds": 60,
      "RecoveryScanIntervalSeconds": 15,
      "SchedulerIdleSeconds": 1,
      "DriftBatchSize": 32,
      "RecoveryBatchSize": 16,
      "ExpiredExceptionBatchSize": 32,
      "OwnerInstanceId": "mfc-controller",
      "SystemActor": "system:operational-jobs"
    }
  }
}
