<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Mfc.Desktop.ViewModels"
        xmlns:svc="using:Mfc.Desktop.Services"
        x:Class="Mfc.Desktop.MainWindow"
        x:DataType="vm:ShellViewModel"
        Title="MikroTik Firewall Controller"
        Width="1440"
        Height="900"
        MinWidth="1024"
        MinHeight="680"
        Focusable="True">
  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+1" Command="{Binding SelectModuleCommand}" CommandParameter="{x:Static vm:ShellNavigationModule.Inventory}" />
    <KeyBinding Gesture="Ctrl+2" Command="{Binding SelectModuleCommand}" CommandParameter="{x:Static vm:ShellNavigationModule.Node}" />
    <KeyBinding Gesture="Ctrl+3" Command="{Binding SelectModuleCommand}" CommandParameter="{x:Static vm:ShellNavigationModule.Snapshots}" />
    <KeyBinding Gesture="Ctrl+4" Command="{Binding SelectModuleCommand}" CommandParameter="{x:Static vm:ShellNavigationModule.Policies}" />
    <KeyBinding Gesture="Ctrl+5" Command="{Binding SelectModuleCommand}" CommandParameter="{x:Static vm:ShellNavigationModule.Operations}" />
    <KeyBinding Gesture="Ctrl+6" Command="{Binding SelectModuleCommand}" CommandParameter="{x:Static vm:ShellNavigationModule.Drift}" />
    <KeyBinding Gesture="Ctrl+7" Command="{Binding SelectModuleCommand}" CommandParameter="{x:Static vm:ShellNavigationModule.Audit}" />
    <KeyBinding Gesture="F5" Command="{Binding Inventory.RefreshCommand}" />
  </Window.KeyBindings>

  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,10">
      <TextBlock FontSize="22" FontWeight="SemiBold" Text="MTDirector" />
      <TextBlock Opacity="0.8"
                 Text="Inventory · Node · Snapshots · Policies · Operations · Drift · Audit" />
      <TextBlock Text="{Binding ControllerEndpoint, StringFormat=Endpoint: {0}}" />
      <TextBlock FontSize="16" Text="{Binding StatusText, StringFormat=Status: {0}}" FontWeight="Bold" />
      <TextBlock Text="{Binding HotKeysText}" Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
      <TextBlock Text="{Binding ErrorText}"
                 TextWrapping="Wrap"
                 IsVisible="{Binding HasError}"
                 Foreground="#B00020" />
      <StackPanel Orientation="Horizontal" Spacing="12">
        <Button Content="Connect" Command="{Binding ConnectCommand}" MinWidth="120" />
        <Button Content="Disconnect" Command="{Binding DisconnectCommand}" MinWidth="120" />
      </StackPanel>
    </StackPanel>

    <Grid ColumnDefinitions="240,12,150,12,*" RowDefinitions="Auto,*,Auto">
      <!-- Inventory tree (always visible) -->
      <DockPanel Grid.Column="0" Grid.Row="0" Margin="0,0,0,8">
        <StackPanel Orientation="Horizontal" Spacing="8" DockPanel.Dock="Right">
          <Border Background="#E8EEF5"
                  CornerRadius="4"
                  Padding="8,2"
                  IsVisible="{Binding Inventory.IsCached}">
            <TextBlock Text="{Binding Inventory.CachedBadgeText}" FontWeight="SemiBold" />
          </Border>
          <Button Content="Refresh"
                  Command="{Binding Inventory.RefreshCommand}"
                  MinWidth="80" />
        </StackPanel>
        <TextBlock FontSize="15" FontWeight="SemiBold" Text="Inventory" VerticalAlignment="Center" />
      </DockPanel>

      <Border Grid.Column="0"
              Grid.Row="1"
              BorderBrush="#D0D5DD"
              BorderThickness="1"
              Padding="4">
        <TreeView ItemsSource="{Binding Inventory.Roots}"
                  SelectedItem="{Binding Inventory.SelectedNode, Mode=TwoWay}">
          <TreeView.ItemTemplate>
            <TreeDataTemplate DataType="vm:InventoryNodeViewModel"
                              ItemsSource="{Binding Children}">
              <StackPanel Orientation="Horizontal" Spacing="6" ToolTip.Tip="{Binding DetailSummary}">
                <TextBlock Text="{Binding KindLabel}" Opacity="0.65" Width="48" />
                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding WorkflowStatusText}"
                           Opacity="0.8"
                           FontSize="11" />
              </StackPanel>
            </TreeDataTemplate>
          </TreeView.ItemTemplate>
        </TreeView>
      </Border>

      <TextBlock Grid.Column="0"
                 Grid.Row="2"
                 Margin="0,8,0,0"
                 TextWrapping="Wrap"
                 Foreground="#B00020"
                 Text="{Binding Inventory.ErrorText}"
                 IsVisible="{Binding Inventory.HasError}" />

      <!-- Module navigation -->
      <TextBlock Grid.Column="2" Grid.Row="0"
                 FontSize="15" FontWeight="SemiBold"
                 Text="Modules"
                 Margin="0,0,0,8"
                 VerticalAlignment="Center" />
      <Border Grid.Column="2"
              Grid.Row="1"
              Grid.RowSpan="2"
              BorderBrush="#D0D5DD"
              BorderThickness="1"
              Padding="4">
        <ListBox ItemsSource="{Binding Modules}"
                 SelectedItem="{Binding SelectedModule, Mode=TwoWay}"
                 Name="ModuleNavList">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <VirtualizingStackPanel />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
        </ListBox>
      </Border>

      <!-- Module content -->
      <Panel Grid.Column="4" Grid.Row="0" Grid.RowSpan="3">
        <!-- Inventory detail + Zones -->
        <ScrollViewer IsVisible="{Binding IsInventorySelected}" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="10" Margin="0,0,0,8">
            <TextBlock FontSize="16" FontWeight="SemiBold" Text="Inventory detail" />
            <TextBlock Text="{Binding Inventory.SelectedNode.DetailSummary}"
                       TextWrapping="Wrap"
                       Opacity="0.9" />
            <TextBlock FontWeight="SemiBold" Text="Workflow status" />
            <TextBlock Text="{Binding Inventory.SelectedNode.WorkflowStatusText}"
                       FontSize="18"
                       FontWeight="Bold" />
            <TextBlock FontWeight="SemiBold" Text="Device hashes" />
            <TextBlock Text="{Binding Inventory.SelectedNode.DesiredHashText, StringFormat=desired: {0}}"
                       FontFamily="Consolas,Menlo,monospace" />
            <TextBlock Text="{Binding Inventory.SelectedNode.CommittedHashText, StringFormat=committed: {0}}"
                       FontFamily="Consolas,Menlo,monospace" />
            <TextBlock Text="{Binding Inventory.SelectedNode.ActualHashText, StringFormat=actual: {0}}"
                       FontFamily="Consolas,Menlo,monospace" />

            <Border BorderBrush="#D0D5DD" BorderThickness="1" Padding="10" Margin="0,12,0,0">
              <StackPanel Spacing="8">
                <TextBlock FontSize="15" FontWeight="SemiBold" Text="Add router" />
                <TextBlock Opacity="0.8" TextWrapping="Wrap"
                           Text="Site → Node → Device + API-SSL credentials (RegisterDevice + UpdateDeviceConnection)." />
                <TextBlock Text="{Binding AddRouter.ErrorText}"
                           Foreground="#B00020"
                           TextWrapping="Wrap"
                           IsVisible="{Binding AddRouter.HasError}" />
                <TextBlock Text="{Binding AddRouter.StatusText}"
                           TextWrapping="Wrap"
                           IsVisible="{Binding AddRouter.HasStatus}" />

                <TextBlock FontWeight="SemiBold" Text="1. Site" />
                <CheckBox Content="Use existing Site"
                          IsChecked="{Binding AddRouter.UseExistingSite}" />
                <ComboBox ItemsSource="{Binding AddRouter.SiteChoices}"
                          SelectedItem="{Binding AddRouter.SelectedSite, Mode=TwoWay}"
                          IsVisible="{Binding AddRouter.ShowExistingSitePicker}"
                          MinWidth="280"
                          HorizontalAlignment="Left" />
                <StackPanel Spacing="6" IsVisible="{Binding AddRouter.ShowNewSiteFields}">
                  <TextBox PlaceholderText="site code" Text="{Binding AddRouter.NewSiteCode}" />
                  <TextBox PlaceholderText="site name" Text="{Binding AddRouter.NewSiteName}" />
                </StackPanel>

                <TextBlock FontWeight="SemiBold" Text="2. Node" Margin="0,6,0,0" />
                <CheckBox Content="Use existing Node"
                          IsChecked="{Binding AddRouter.UseExistingNode}" />
                <ComboBox ItemsSource="{Binding AddRouter.NodeChoices}"
                          SelectedItem="{Binding AddRouter.SelectedNode, Mode=TwoWay}"
                          IsVisible="{Binding AddRouter.ShowExistingNodePicker}"
                          MinWidth="280"
                          HorizontalAlignment="Left" />
                <StackPanel Spacing="6" IsVisible="{Binding AddRouter.ShowNewNodeFields}">
                  <TextBox PlaceholderText="node name" Text="{Binding AddRouter.NewNodeName}" />
                  <ComboBox ItemsSource="{Binding AddRouter.UplinkModes}"
                            SelectedItem="{Binding AddRouter.SelectedUplinkMode, Mode=TwoWay}"
                            MinWidth="220"
                            HorizontalAlignment="Left" />
                </StackPanel>

                <TextBlock FontWeight="SemiBold" Text="3. Device" Margin="0,6,0,0" />
                <TextBox PlaceholderText="display name" Text="{Binding AddRouter.DeviceDisplayName}" />
                <TextBox PlaceholderText="management host (IP or DNS)" Text="{Binding AddRouter.ManagementHost}" />
                <TextBox PlaceholderText="management port (8729)" Text="{Binding AddRouter.ManagementPortText}" />

                <TextBlock FontWeight="SemiBold" Text="4. Connection profile" Margin="0,6,0,0" />
                <TextBox PlaceholderText="API username" Text="{Binding AddRouter.Username}" />
                <TextBox PlaceholderText="API password"
                         Text="{Binding AddRouter.Password}"
                         PasswordChar="*" />
                <ComboBox ItemsSource="{Binding AddRouter.TrustModes}"
                          SelectedItem="{Binding AddRouter.SelectedTrustMode, Mode=TwoWay}"
                          MinWidth="220"
                          HorizontalAlignment="Left" />
                <TextBox PlaceholderText="CA profile ref"
                         Text="{Binding AddRouter.CaProfileRef}"
                         IsVisible="{Binding AddRouter.ShowCaProfile}" />
                <TextBox PlaceholderText="pinned SPKI SHA-256 (64 hex)"
                         Text="{Binding AddRouter.PinnedSpkiSha256Hex}"
                         IsVisible="{Binding AddRouter.ShowSpkiPin}"
                         FontFamily="Consolas,Menlo,monospace" />

                <Button Content="Create / register"
                        Command="{Binding AddRouter.SubmitCommand}"
                        MinWidth="160"
                        HorizontalAlignment="Left"
                        Margin="0,4,0,0" />
              </StackPanel>
            </Border>

            <Border BorderBrush="#D0D5DD" BorderThickness="1" Padding="8" Margin="0,12,0,0">
              <Grid ColumnDefinitions="*,12,*" RowDefinitions="Auto,*,Auto,*,Auto,*">
                <DockPanel Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="0" Margin="0,0,0,8">
                  <StackPanel Orientation="Horizontal" Spacing="8" DockPanel.Dock="Right">
                    <Button Content="Refresh" Command="{Binding Zones.RefreshCommand}" MinWidth="80" />
                    <Button Content="Resolve node" Command="{Binding Zones.ResolveCommand}" MinWidth="110" />
                  </StackPanel>
                  <StackPanel Spacing="2">
                    <TextBlock FontSize="15" FontWeight="SemiBold" Text="Logical zones &amp; Node bindings" />
                    <TextBlock Text="{Binding Zones.SelectedNodeHint}" Opacity="0.8" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Zones.ErrorText}"
                               Foreground="#B00020"
                               TextWrapping="Wrap"
                               IsVisible="{Binding Zones.HasError}" />
                  </StackPanel>
                </DockPanel>

                <Border Grid.Column="0" Grid.Row="1" BorderBrush="#D0D5DD" BorderThickness="1" Padding="8">
                  <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
                      <TextBlock FontWeight="SemiBold" Text="Company zones" />
                      <TextBox PlaceholderText="key" Text="{Binding Zones.NewZoneKey}" />
                      <TextBox PlaceholderText="name" Text="{Binding Zones.NewZoneName}" />
                      <TextBox PlaceholderText="description (optional)" Text="{Binding Zones.NewZoneDescription}" />
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Create" Command="{Binding Zones.CreateZoneCommand}" MinWidth="90" />
                        <Button Content="Delete" Command="{Binding Zones.DeleteZoneCommand}" MinWidth="90" />
                      </StackPanel>
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Zones.Zones}"
                             SelectedItem="{Binding Zones.SelectedZone, Mode=TwoWay}"
                             MaxHeight="220">
                      <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                          <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                      </ListBox.ItemsPanel>
                      <ListBox.ItemTemplate>
                        <DataTemplate DataType="svc:ZoneDefinitionListItem">
                          <TextBlock Text="{Binding SummaryLine}" TextWrapping="Wrap" Margin="2" />
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </DockPanel>
                </Border>

                <Border Grid.Column="2" Grid.Row="1" BorderBrush="#D0D5DD" BorderThickness="1" Padding="8">
                  <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
                      <TextBlock FontWeight="SemiBold" Text="Node bindings" />
                      <ComboBox ItemsSource="{Binding Zones.BindingKinds}"
                                SelectedItem="{Binding Zones.SelectedBindingKind, Mode=TwoWay}"
                                MinWidth="220" />
                      <TextBox PlaceholderText="values (comma-separated)" Text="{Binding Zones.BindingValuesText}" />
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Upsert binding" Command="{Binding Zones.UpsertBindingCommand}" MinWidth="120" />
                        <Button Content="Delete binding" Command="{Binding Zones.DeleteBindingCommand}" MinWidth="120" />
                      </StackPanel>
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Zones.Bindings}"
                             SelectedItem="{Binding Zones.SelectedBinding, Mode=TwoWay}"
                             MaxHeight="220">
                      <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                          <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                      </ListBox.ItemsPanel>
                      <ListBox.ItemTemplate>
                        <DataTemplate DataType="svc:NodeZoneBindingListItem">
                          <TextBlock Text="{Binding SummaryLine}" TextWrapping="Wrap" Margin="2" />
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </DockPanel>
                </Border>

                <TextBlock Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="2"
                           Margin="0,12,0,4" FontWeight="SemiBold" Text="Resolve results / blockers" />
                <Border Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="3"
                        BorderBrush="#D0D5DD" BorderThickness="1" Padding="4" MinHeight="120">
                  <ListBox ItemsSource="{Binding Zones.ResolveResults}">
                    <ListBox.ItemsPanel>
                      <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                      </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                      <DataTemplate DataType="svc:ZoneResolveResultListItem">
                        <TextBlock Text="{Binding SummaryLine}" TextWrapping="Wrap" Margin="4"
                                   FontFamily="Consolas,Menlo,monospace" />
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Border>
              </Grid>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- Node -->
        <ScrollViewer IsVisible="{Binding IsNodeSelected}" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="10" Margin="0,0,0,8">
            <DockPanel>
              <Button Content="Refresh" Command="{Binding Node.RefreshCommand}" DockPanel.Dock="Right" MinWidth="80" />
              <TextBlock FontSize="16" FontWeight="SemiBold" Text="Node" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock Text="{Binding Node.SelectionHint}" Opacity="0.85" TextWrapping="Wrap" />
            <TextBlock FontWeight="SemiBold" Text="Topology" />
            <TextBlock Text="{Binding Node.TopologyText}" TextWrapping="Wrap" />
            <TextBlock FontWeight="SemiBold" Text="Workflow / readiness" />
            <TextBlock Text="{Binding Node.WorkflowStatusText}" FontSize="18" FontWeight="Bold" />
            <TextBlock Text="{Binding Node.DeploymentReadinessText}" TextWrapping="Wrap" Opacity="0.9" />
            <TextBlock FontWeight="SemiBold" Text="Onboarding readiness" />
            <TextBlock Text="{Binding Node.OnboardingReadinessText}" TextWrapping="Wrap" />
            <TextBlock FontWeight="SemiBold" Text="Zones summary" />
            <ListBox ItemsSource="{Binding Node.ZoneSummaryLines}" MaxHeight="160">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <VirtualizingStackPanel />
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
            </ListBox>
            <TextBlock FontWeight="SemiBold" Text="Device hashes" />
            <ListBox ItemsSource="{Binding Node.DeviceHashLines}" MaxHeight="200">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <VirtualizingStackPanel />
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
            </ListBox>

            <Border BorderBrush="#D0D5DD" BorderThickness="1" Padding="8" Margin="0,12,0,0">
              <StackPanel Spacing="8">
                <DockPanel>
                  <Button Content="Refresh"
                          Command="{Binding RoutingAssurance.RefreshCommand}"
                          DockPanel.Dock="Right"
                          MinWidth="80" />
                  <TextBlock FontWeight="SemiBold" Text="Routing assurance (read-only)" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock Text="{Binding RoutingAssurance.StatusText}" Opacity="0.85" TextWrapping="Wrap" />
                <TextBlock Text="{Binding RoutingAssurance.ErrorText}"
                           Foreground="#B00020"
                           TextWrapping="Wrap"
                           IsVisible="{Binding RoutingAssurance.HasError}" />
                <TextBlock Text="{Binding RoutingAssurance.ConfigurationHashText, StringFormat=configuration_hash: {0}}"
                           FontFamily="Consolas,Menlo,monospace"
                           TextWrapping="Wrap" />
                <TextBlock Text="{Binding RoutingAssurance.OperationalHashText, StringFormat=operational_hash: {0}}"
                           FontFamily="Consolas,Menlo,monospace"
                           TextWrapping="Wrap" />
                <TextBlock FontWeight="SemiBold" Text="Route expectations" />
                <ListBox ItemsSource="{Binding RoutingAssurance.ExpectationLines}" MaxHeight="120">
                  <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                      <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                  </ListBox.ItemsPanel>
                </ListBox>
                <TextBlock FontWeight="SemiBold" Text="Route findings" />
                <ListBox ItemsSource="{Binding RoutingAssurance.FindingLines}" MaxHeight="120">
                  <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                      <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                  </ListBox.ItemsPanel>
                </ListBox>
                <TextBlock FontWeight="SemiBold" Text="Trace summaries" />
                <ListBox ItemsSource="{Binding RoutingAssurance.TraceSummaryLines}" MaxHeight="160">
                  <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                      <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                  </ListBox.ItemsPanel>
                </ListBox>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- Snapshots: Snapshot + Diff -->
        <TabControl IsVisible="{Binding IsSnapshotsSelected}">
          <TabItem Header="Snapshot">
            <Grid ColumnDefinitions="220,12,*" RowDefinitions="Auto,*,Auto" Margin="0,8,0,0">
              <DockPanel Grid.Column="0" Grid.Row="0" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal" Spacing="8" DockPanel.Dock="Right">
                  <CheckBox Content="Technical"
                            IsChecked="{Binding Snapshot.ShowTechnicalView}" />
                  <Button Content="Reload"
                          Command="{Binding Snapshot.ReloadCommand}"
                          MinWidth="80" />
                </StackPanel>
                <TextBlock FontSize="15" FontWeight="SemiBold" Text="Sections" VerticalAlignment="Center" />
              </DockPanel>

              <Border Grid.Column="0"
                      Grid.Row="1"
                      BorderBrush="#D0D5DD"
                      BorderThickness="1"
                      Padding="4">
                <ListBox ItemsSource="{Binding Snapshot.VisibleSections}"
                         SelectedItem="{Binding Snapshot.SelectedSection, Mode=TwoWay}">
                  <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                      <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                  </ListBox.ItemsPanel>
                  <ListBox.ItemTemplate>
                    <DataTemplate DataType="svc:SnapshotSectionListItem">
                      <StackPanel Spacing="2" Margin="2">
                        <TextBlock Text="{Binding SectionId}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Opacity="0.75" Text="{Binding StatusText, StringFormat=Status: {0}}" />
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Border>

              <TextBlock Grid.Column="0"
                         Grid.Row="2"
                         Margin="0,8,0,0"
                         TextWrapping="Wrap"
                         Foreground="#B00020"
                         Text="{Binding Snapshot.ErrorText}"
                         IsVisible="{Binding Snapshot.HasError}" />

              <DockPanel Grid.Column="2" Grid.Row="0" Margin="0,0,0,8">
                <Button Content="Copy sanitized"
                        Command="{Binding Snapshot.CopySanitizedCommand}"
                        DockPanel.Dock="Right"
                        MinWidth="120" />
                <TextBlock FontSize="15" FontWeight="SemiBold" Text="Snapshot (configuration / observations)" VerticalAlignment="Center" />
              </DockPanel>

              <Border Grid.Column="2"
                      Grid.Row="1"
                      Grid.RowSpan="2"
                      BorderBrush="#D0D5DD"
                      BorderThickness="1"
                      Padding="10">
                <Grid RowDefinitions="Auto,Auto,*,*">
                  <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,8">
                    <TextBlock Text="{Binding Snapshot.HintText}" TextWrapping="Wrap" Opacity="0.85" />
                    <TextBlock Text="{Binding Snapshot.StatusText, StringFormat=Capture status: {0}}" />
                    <TextBlock Text="{Binding Snapshot.SchemaVersionText, StringFormat=Schema version: {0}}" />
                    <TextBlock Text="{Binding Snapshot.ConfigurationHashText, StringFormat=configuration_hash: {0}}"
                               FontFamily="Consolas,Menlo,monospace"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Snapshot.ObservationHashText, StringFormat=observation_hash: {0}}"
                               FontFamily="Consolas,Menlo,monospace"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Snapshot.CapabilityHashText, StringFormat=capability_hash: {0}}"
                               FontFamily="Consolas,Menlo,monospace"
                               TextWrapping="Wrap" />
                    <ComboBox ItemsSource="{Binding Snapshot.Captures}"
                              SelectedItem="{Binding Snapshot.SelectedCapture, Mode=TwoWay}"
                              MinWidth="280"
                              PlaceholderText="Captures">
                      <ComboBox.ItemTemplate>
                        <DataTemplate DataType="svc:SnapshotCaptureListItem">
                          <TextBlock Text="{Binding CompletedAtText}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </StackPanel>

                  <TextBlock Grid.Row="1" Margin="0,4,0,4" FontWeight="SemiBold" Text="Configuration records" />
                  <ListBox Grid.Row="2" ItemsSource="{Binding Snapshot.ConfigurationRecords}" Margin="0,0,0,8">
                    <ListBox.ItemsPanel>
                      <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                      </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                      <DataTemplate DataType="svc:SnapshotRecordListItem">
                        <TextBlock Text="{Binding SummaryLine}" TextWrapping="Wrap" Margin="2" />
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>

                  <DockPanel Grid.Row="3">
                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,4" FontWeight="SemiBold" Text="Observation records" />
                    <ListBox ItemsSource="{Binding Snapshot.ObservationRecords}">
                      <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                          <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                      </ListBox.ItemsPanel>
                      <ListBox.ItemTemplate>
                        <DataTemplate DataType="svc:SnapshotRecordListItem">
                          <TextBlock Text="{Binding SummaryLine}" TextWrapping="Wrap" Margin="2" />
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </DockPanel>
                </Grid>
              </Border>
            </Grid>
          </TabItem>

          <TabItem Header="Semantic diff">
            <Grid ColumnDefinitions="220,12,*" RowDefinitions="Auto,*" Margin="0,8,0,0">
              <StackPanel Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="0" Spacing="8" Margin="0,0,0,10">
                <TextBlock FontSize="15" FontWeight="SemiBold" Text="Compare snapshots (server-side)" />
                <TextBlock Text="{Binding Diff.StatusText}" TextWrapping="Wrap" Opacity="0.85" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <StackPanel Spacing="4">
                    <TextBlock Text="Base" FontWeight="SemiBold" />
                    <ComboBox ItemsSource="{Binding Diff.Captures}"
                              SelectedItem="{Binding Diff.BaseCapture, Mode=TwoWay}"
                              MinWidth="260"
                              PlaceholderText="Base capture">
                      <ComboBox.ItemTemplate>
                        <DataTemplate DataType="svc:SnapshotCaptureListItem">
                          <TextBlock Text="{Binding CompletedAtText}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </StackPanel>
                  <StackPanel Spacing="4">
                    <TextBlock Text="Target" FontWeight="SemiBold" />
                    <ComboBox ItemsSource="{Binding Diff.Captures}"
                              SelectedItem="{Binding Diff.TargetCapture, Mode=TwoWay}"
                              MinWidth="260"
                              PlaceholderText="Target capture">
                      <ComboBox.ItemTemplate>
                        <DataTemplate DataType="svc:SnapshotCaptureListItem">
                          <TextBlock Text="{Binding CompletedAtText}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </StackPanel>
                  <Button Content="Compare"
                          Command="{Binding Diff.CompareCommand}"
                          VerticalAlignment="Bottom"
                          MinWidth="100" />
                  <Button Content="Reload captures"
                          Command="{Binding Diff.ReloadCapturesCommand}"
                          VerticalAlignment="Bottom"
                          MinWidth="120" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="16">
                  <CheckBox Content="Configuration only"
                            IsChecked="{Binding Diff.ShowConfigurationOnly}" />
                  <CheckBox Content="Observations only"
                            IsChecked="{Binding Diff.ShowObservationOnly}" />
                </StackPanel>
                <TextBlock Text="No differences"
                           FontSize="18"
                           FontWeight="Bold"
                           IsVisible="{Binding Diff.IsNoDifferences}" />
                <TextBlock Text="{Binding Diff.ErrorText}"
                           TextWrapping="Wrap"
                           Foreground="#B00020"
                           IsVisible="{Binding Diff.HasError}" />
              </StackPanel>

              <Border Grid.Column="0"
                      Grid.Row="1"
                      BorderBrush="#D0D5DD"
                      BorderThickness="1"
                      Padding="4">
                <ListBox ItemsSource="{Binding Diff.SectionGroups}"
                         SelectedItem="{Binding Diff.SelectedSectionGroup, Mode=TwoWay}">
                  <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                      <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                  </ListBox.ItemsPanel>
                  <ListBox.ItemTemplate>
                    <DataTemplate DataType="svc:SnapshotDiffSectionGroup">
                      <StackPanel Spacing="2" Margin="2">
                        <TextBlock Text="{Binding SectionId}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Opacity="0.75" Text="{Binding EntryCount, StringFormat={}{0} entries}" />
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Border>

              <Border Grid.Column="2"
                      Grid.Row="1"
                      BorderBrush="#D0D5DD"
                      BorderThickness="1"
                      Padding="4">
                <ListBox ItemsSource="{Binding Diff.VisibleEntries}">
                  <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                      <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                  </ListBox.ItemsPanel>
                  <ListBox.ItemTemplate>
                    <DataTemplate DataType="svc:SnapshotDiffEntryItem">
                      <StackPanel Spacing="2" Margin="4">
                        <TextBlock Text="{Binding HeaderLine}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding ConfidenceText, StringFormat=Confidence: {0}}" Opacity="0.75" />
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Border>
            </Grid>
          </TabItem>
        </TabControl>

        <!-- Policies -->
        <ScrollViewer IsVisible="{Binding IsPoliciesSelected}" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="10">
            <StackPanel Spacing="2">
              <TextBlock FontSize="15" FontWeight="SemiBold" Text="Policy authoring / review / binding" />
              <TextBlock Text="{Binding Policies.ReadOnlyBannerText}"
                         Foreground="#8A5A00"
                         TextWrapping="Wrap"
                         IsVisible="{Binding Policies.IsReadOnlyBannerVisible}" />
              <TextBlock Text="{Binding Policies.ErrorText}"
                         Foreground="#B00020"
                         TextWrapping="Wrap"
                         IsVisible="{Binding Policies.HasError}" />
            </StackPanel>

            <Border BorderBrush="#D0D5DD" BorderThickness="1" Padding="8">
              <StackPanel Spacing="6">
                <TextBlock FontWeight="SemiBold" Text="Revision" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBox PlaceholderText="revision UUID"
                           Text="{Binding Policies.RevisionIdText}"
                           MinWidth="280" />
                  <Button Content="Load" Command="{Binding Policies.LoadCommand}" MinWidth="80" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBox PlaceholderText="draft name (CompanyBaseline)"
                           Text="{Binding Policies.DraftNameText}"
                           MinWidth="280" />
                  <Button Content="Create draft" Command="{Binding Policies.CreateDraftCommand}" MinWidth="110" />
                </StackPanel>
                <TextBlock Text="{Binding Policies.StateText, StringFormat=State: {0}}" />
                <TextBlock Text="{Binding Policies.ContentHashText, StringFormat=Content hash: {0}}"
                           FontFamily="Consolas,Menlo,monospace"
                           TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="Validate" Command="{Binding Policies.ValidateCommand}" MinWidth="90" />
                  <Button Content="Submit for review" Command="{Binding Policies.SubmitCommand}" MinWidth="130" />
                  <Button Content="Approve" Command="{Binding Policies.ApproveCommand}" MinWidth="90" />
                  <Button Content="Bind" Command="{Binding Policies.BindCommand}" MinWidth="80" />
                  <Button Content="Deploy" Command="{Binding Policies.DeployCommand}" MinWidth="90"
                          ToolTip.Tip="Deploy blocked from authoring (no Save and Deploy). Use Operations → Deploy." />
                </StackPanel>
              </StackPanel>
            </Border>

            <Border BorderBrush="#D0D5DD" BorderThickness="1" Padding="8">
              <StackPanel Spacing="6">
                <TextBlock FontWeight="SemiBold" Text="Rules" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <ComboBox ItemsSource="{Binding Policies.Families}"
                            SelectedItem="{Binding Policies.SelectedFamily, Mode=TwoWay}"
                            MinWidth="100" />
                  <ComboBox ItemsSource="{Binding Policies.Chains}"
                            SelectedItem="{Binding Policies.SelectedChain, Mode=TwoWay}"
                            MinWidth="120" />
                  <ComboBox ItemsSource="{Binding Policies.Stages}"
                            SelectedItem="{Binding Policies.SelectedStage, Mode=TwoWay}"
                            MinWidth="180" />
                  <ComboBox ItemsSource="{Binding Policies.Effects}"
                            SelectedItem="{Binding Policies.SelectedEffect, Mode=TwoWay}"
                            MinWidth="140" />
                </StackPanel>
                <TextBox PlaceholderText="description" Text="{Binding Policies.RuleDescriptionText}" />
                <Button Content="Add rule" Command="{Binding Policies.AddRuleCommand}" MinWidth="100" HorizontalAlignment="Left" />
                <ListBox ItemsSource="{Binding Policies.Rules}" MaxHeight="180">
                  <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                      <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                  </ListBox.ItemsPanel>
                  <ListBox.ItemTemplate>
                    <DataTemplate DataType="svc:PolicyRuleListItem">
                      <TextBlock Text="{Binding SummaryLine}" TextWrapping="Wrap" Margin="2"
                                 FontFamily="Consolas,Menlo,monospace" />
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </StackPanel>
            </Border>

            <Border BorderBrush="#D0D5DD" BorderThickness="1" Padding="8">
              <StackPanel Spacing="6">
                <TextBlock FontWeight="SemiBold" Text="Review: compose / diff / analysis risk" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBox PlaceholderText="compose node UUID"
                           Text="{Binding Policies.ComposeNodeIdText}"
                           MinWidth="280" />
                  <Button Content="Compose findings" Command="{Binding Policies.ComposeCommand}" MinWidth="130" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBox PlaceholderText="baseline revision UUID"
                           Text="{Binding Policies.DiffBaselineRevisionIdText}"
                           MinWidth="280" />
                  <Button Content="Semantic diff" Command="{Binding Policies.DiffCommand}" MinWidth="120" />
                </StackPanel>
                <ListBox ItemsSource="{Binding Policies.Findings}" MaxHeight="120">
                  <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                      <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                  </ListBox.ItemsPanel>
                  <ListBox.ItemTemplate>
                    <DataTemplate DataType="svc:PolicyFindingListItem">
                      <TextBlock Text="{Binding SummaryLine}" TextWrapping="Wrap" Margin="2"
                                 FontFamily="Consolas,Menlo,monospace" />
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- Operations: Onboarding + Deploy + recovery -->
        <TabControl IsVisible="{Binding IsOperationsSelected}">
          <TabItem Header="Onboarding">
            <ScrollViewer Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
              <StackPanel Spacing="10">
                <StackPanel Spacing="2">
                  <TextBlock FontSize="15" FontWeight="SemiBold" Text="Managed-device onboarding" />
                  <TextBlock Text="{Binding Onboarding.StatusText}" Opacity="0.85" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Onboarding.ErrorText}"
                             Foreground="#B00020"
                             TextWrapping="Wrap"
                             IsVisible="{Binding Onboarding.HasError}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="Validate prerequisites" Command="{Binding Onboarding.ValidateCommand}" MinWidth="160" />
                  <Button Content="Create plan" Command="{Binding Onboarding.CreatePlanCommand}" MinWidth="110" />
                  <Button Content="Start" Command="{Binding Onboarding.StartCommand}" MinWidth="80" />
                  <Button Content="Rollback" Command="{Binding Onboarding.RollbackCommand}" MinWidth="90" />
                  <Button Content="Recovery status" Command="{Binding Onboarding.RecoveryCommand}" MinWidth="130" />
                </StackPanel>
                <TextBlock FontWeight="SemiBold" Text="Prerequisite checklist" />
                <ListBox ItemsSource="{Binding Onboarding.Findings}" MaxHeight="140">
                  <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                      <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                  </ListBox.ItemsPanel>
                  <ListBox.ItemTemplate>
                    <DataTemplate DataType="svc:OnboardingFindingListItem">
                      <TextBlock Text="{Binding SummaryLine}" TextWrapping="Wrap" Margin="2"
                                 FontFamily="Consolas,Menlo,monospace" />
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock FontWeight="SemiBold" Text="Recovery facts" />
                <TextBlock Text="{Binding Onboarding.RecoveryFactsText}"
                           TextWrapping="Wrap"
                           FontFamily="Consolas,Menlo,monospace" />
                <TextBlock FontWeight="SemiBold" Text="Progress" />
                <ListBox ItemsSource="{Binding Onboarding.ProgressLines}" MaxHeight="120">
                  <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                      <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                  </ListBox.ItemsPanel>
                </ListBox>
              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <TabItem Header="Deploy">
            <ScrollViewer Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
              <StackPanel Spacing="10">
                <StackPanel Spacing="2">
                  <TextBlock FontSize="15" FontWeight="SemiBold" Text="Safe deployment" />
                  <TextBlock Text="{Binding Deployment.StatusText}" Opacity="0.85" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Deployment.ErrorText}"
                             Foreground="#B00020"
                             TextWrapping="Wrap"
                             IsVisible="{Binding Deployment.HasError}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="Create plan" Command="{Binding Deployment.CreatePlanCommand}" MinWidth="110" />
                  <Button Content="Start" Command="{Binding Deployment.StartCommand}" MinWidth="80" />
                  <Button Content="Rollback" Command="{Binding Deployment.RollbackCommand}" MinWidth="90" />
                  <Button Content="Recovery status" Command="{Binding Deployment.RecoveryCommand}" MinWidth="130" />
                </StackPanel>
                <TextBlock FontWeight="SemiBold" Text="Semantic diff" />
                <ListBox ItemsSource="{Binding Deployment.SemanticDiffLines}" MaxHeight="100">
                  <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                      <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                  </ListBox.ItemsPanel>
                </ListBox>
                <TextBlock FontWeight="SemiBold" Text="Recovery facts" />
                <TextBlock Text="{Binding Deployment.RecoveryFactsText}"
                           TextWrapping="Wrap"
                           FontFamily="Consolas,Menlo,monospace" />
                <TextBlock FontWeight="SemiBold" Text="Progress" />
                <ListBox ItemsSource="{Binding Deployment.ProgressLines}" MaxHeight="120">
                  <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                      <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                  </ListBox.ItemsPanel>
                </ListBox>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
        </TabControl>

        <!-- Drift (no automatic fix) -->
        <Grid IsVisible="{Binding IsDriftSelected}" RowDefinitions="Auto,*,*" Margin="0,0,0,0">
          <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" Spacing="8" DockPanel.Dock="Right">
              <Button Content="Refresh" Command="{Binding Drift.RefreshCommand}" MinWidth="80" />
            </StackPanel>
            <StackPanel Spacing="2">
              <TextBlock FontSize="16" FontWeight="SemiBold" Text="Drift" />
              <TextBlock Text="Read-only drift events. Restoration is via Operations → Deploy (no automatic fix)."
                         Opacity="0.8" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Drift.StatusText}" Opacity="0.85" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Drift.ErrorText}"
                         Foreground="#B00020"
                         TextWrapping="Wrap"
                         IsVisible="{Binding Drift.HasError}" />
            </StackPanel>
          </DockPanel>
          <Border Grid.Row="1" BorderBrush="#D0D5DD" BorderThickness="1" Padding="4" Margin="0,0,0,8">
            <ListBox ItemsSource="{Binding Drift.Events}"
                     SelectedItem="{Binding Drift.SelectedEvent, Mode=TwoWay}"
                     Name="DriftEventsList">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <VirtualizingStackPanel />
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate DataType="vm:DriftEventListItem">
                  <StackPanel Spacing="2" Margin="4">
                    <TextBlock Text="{Binding SummaryLine}" TextWrapping="Wrap" FontWeight="SemiBold" />
                    <TextBlock Opacity="0.75"
                               Text="{Binding BaselineHashText, StringFormat=baseline: {0}}"
                               FontFamily="Consolas,Menlo,monospace" />
                    <TextBlock Opacity="0.75"
                               Text="{Binding ActualHashText, StringFormat=actual: {0}}"
                               FontFamily="Consolas,Menlo,monospace" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Border>
          <Border Grid.Row="2" BorderBrush="#D0D5DD" BorderThickness="1" Padding="8">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Text="Semantic diff" Margin="0,0,0,6" />
              <TextBox Text="{Binding Drift.SemanticDiffText}"
                       IsReadOnly="True"
                       AcceptsReturn="True"
                       TextWrapping="Wrap"
                       FontFamily="Consolas,Menlo,monospace" />
            </DockPanel>
          </Border>
        </Grid>

        <!-- Audit (read-only) -->
        <Grid IsVisible="{Binding IsAuditSelected}" RowDefinitions="Auto,*,*" Margin="0,0,0,0">
          <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" Spacing="8" DockPanel.Dock="Right">
              <Button Content="Refresh" Command="{Binding Audit.RefreshCommand}" MinWidth="80" />
            </StackPanel>
            <StackPanel Spacing="2">
              <TextBlock FontSize="16" FontWeight="SemiBold" Text="Audit" />
              <TextBlock Text="Read-only append-only events (newest first). No mutate actions."
                         Opacity="0.8" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Audit.StatusText}" Opacity="0.85" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Audit.ErrorText}"
                         Foreground="#B00020"
                         TextWrapping="Wrap"
                         IsVisible="{Binding Audit.HasError}" />
            </StackPanel>
          </DockPanel>
          <Border Grid.Row="1" BorderBrush="#D0D5DD" BorderThickness="1" Padding="4" Margin="0,0,0,8">
            <ListBox ItemsSource="{Binding Audit.Events}"
                     SelectedItem="{Binding Audit.SelectedEvent, Mode=TwoWay}"
                     Name="AuditEventsList">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <VirtualizingStackPanel />
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate DataType="vm:AuditEventListItem">
                  <TextBlock Text="{Binding SummaryLine}" TextWrapping="Wrap" Margin="4" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Border>
          <Border Grid.Row="2" BorderBrush="#D0D5DD" BorderThickness="1" Padding="8">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Text="Payload (JSON)" Margin="0,0,0,6" />
              <TextBox Text="{Binding Audit.SelectedEvent.PayloadJson}"
                       IsReadOnly="True"
                       AcceptsReturn="True"
                       TextWrapping="Wrap"
                       FontFamily="Consolas,Menlo,monospace" />
            </DockPanel>
          </Border>
        </Grid>
      </Panel>
    </Grid>
  </DockPanel>
</Window>
