<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Mfc.Desktop.ViewModels"
        xmlns:svc="using:Mfc.Desktop.Services"
        x:Class="Mfc.Desktop.MainWindow"
        x:DataType="vm:ShellViewModel"
        Title="MikroTik Firewall Controller"
        Width="1440"
        Height="900"
        MinWidth="1024"
        MinHeight="680"
        Focusable="True">
  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+1" Command="{Binding SelectModuleCommand}" CommandParameter="{x:Static vm:ShellNavigationModule.Inventory}" />
    <KeyBinding Gesture="Ctrl+2" Command="{Binding SelectModuleCommand}" CommandParameter="{x:Static vm:ShellNavigationModule.Node}" />
    <KeyBinding Gesture="Ctrl+3" Command="{Binding SelectModuleCommand}" CommandParameter="{x:Static vm:ShellNavigationModule.Snapshots}" />
    <KeyBinding Gesture="Ctrl+4" Command="{Binding SelectModuleCommand}" CommandParameter="{x:Static vm:ShellNavigationModule.Policies}" />
    <KeyBinding Gesture="Ctrl+5" Command="{Binding SelectModuleCommand}" CommandParameter="{x:Static vm:ShellNavigationModule.Operations}" />
    <KeyBinding Gesture="Ctrl+6" Command="{Binding SelectModuleCommand}" CommandParameter="{x:Static vm:ShellNavigationModule.Drift}" />
    <KeyBinding Gesture="Ctrl+7" Command="{Binding SelectModuleCommand}" CommandParameter="{x:Static vm:ShellNavigationModule.Audit}" />
    <KeyBinding Gesture="F5" Command="{Binding Inventory.RefreshCommand}" />
  </Window.KeyBindings>

  <DockPanel Margin="12">
    <!-- Compact chrome: brand + actions on one row; status below -->
    <Border DockPanel.Dock="Top"
            Classes="mfc-panel"
            Margin="0,0,0,10"
            Padding="12,10">
      <StackPanel Spacing="6">
        <DockPanel LastChildFill="True">
          <StackPanel DockPanel.Dock="Right"
                      Orientation="Horizontal"
                      Spacing="8"
                      VerticalAlignment="Center"
                      Margin="12,0,0,0">
            <Button Classes="mfc-action" Content="Connect" Command="{Binding ConnectCommand}" MinWidth="120" />
            <Button Classes="mfc-action" Content="Disconnect" Command="{Binding DisconnectCommand}" MinWidth="120" />
          </StackPanel>
          <StackPanel Spacing="2" VerticalAlignment="Center">
            <TextBlock Classes="mfc-brand" Text="MTDirector" />
            <TextBlock Classes="mfc-muted"
                       Opacity="0.75"
                       Text="Inventory · Node · Snapshots · Policies · Operations · Drift · Audit" />
          </StackPanel>
        </DockPanel>
        <WrapPanel Classes="mfc-toolbar" ItemSpacing="16" ItemHeight="22">
          <TextBlock VerticalAlignment="Center"
                     Text="{Binding ControllerEndpoint, StringFormat=Endpoint: {0}}" />
          <TextBlock VerticalAlignment="Center"
                     FontWeight="SemiBold"
                     Text="{Binding StatusText, StringFormat=Status: {0}}" />
          <TextBlock VerticalAlignment="Center"
                     Classes="mfc-muted"
                     Opacity="0.7"
                     FontSize="12"
                     Text="{Binding HotKeysText}" />
        </WrapPanel>
        <TextBlock Classes="mfc-error"
                   Text="{Binding ErrorText}"
                   IsVisible="{Binding HasError}" />
      </StackPanel>
    </Border>

    <Grid ColumnDefinitions="260,12,150,12,*" RowDefinitions="Auto,*,Auto">
      <!-- Inventory tree (always visible) -->
      <StackPanel Grid.Column="0" Grid.Row="0" Spacing="6" Margin="0,0,0,8">
        <TextBlock Classes="mfc-section-title" Text="Inventory" />
        <WrapPanel Classes="mfc-toolbar" ItemSpacing="8">
          <Border Classes="mfc-badge" IsVisible="{Binding Inventory.IsCached}">
            <TextBlock Text="{Binding Inventory.CachedBadgeText}" FontWeight="SemiBold" />
          </Border>
          <Button Classes="mfc-action"
                  Content="Refresh"
                  Command="{Binding Inventory.RefreshCommand}" />
        </WrapPanel>
      </StackPanel>

      <Border Grid.Column="0"
              Grid.Row="1"
              Classes="mfc-list-frame"
              ClipToBounds="True">
        <TreeView ItemsSource="{Binding Inventory.Roots}"
                  SelectedItem="{Binding Inventory.SelectedNode, Mode=TwoWay}">
          <TreeView.ItemTemplate>
            <TreeDataTemplate DataType="vm:InventoryNodeViewModel"
                              ItemsSource="{Binding Children}">
              <Grid ColumnDefinitions="44,*,Auto"
                    MinWidth="0"
                    ToolTip.Tip="{Binding DetailSummary}">
                <TextBlock Grid.Column="0"
                           Text="{Binding KindLabel}"
                           Opacity="0.65"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1"
                           Text="{Binding DisplayName}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Margin="4,0" />
                <TextBlock Grid.Column="2"
                           Text="{Binding WorkflowStatusText}"
                           Opacity="0.8"
                           FontSize="11"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="90" />
              </Grid>
            </TreeDataTemplate>
          </TreeView.ItemTemplate>
        </TreeView>
      </Border>

      <TextBlock Grid.Column="0"
                 Grid.Row="2"
                 Margin="0,8,0,0"
                 Classes="mfc-error"
                 Text="{Binding Inventory.ErrorText}"
                 IsVisible="{Binding Inventory.HasError}" />

      <!-- Module navigation -->
      <TextBlock Grid.Column="2" Grid.Row="0"
                 Classes="mfc-section-title"
                 Text="Modules"
                 Margin="0,0,0,8"
                 VerticalAlignment="Center" />
      <Border Grid.Column="2"
              Grid.Row="1"
              Grid.RowSpan="2"
              Classes="mfc-list-frame"
              ClipToBounds="True">
        <ListBox ItemsSource="{Binding Modules}"
                 SelectedItem="{Binding SelectedModule, Mode=TwoWay}"
                 Name="ModuleNavList">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <VirtualizingStackPanel />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
        </ListBox>
      </Border>

      <!-- Module content: single cell, ClipToBounds; only one IsVisible at a time -->
      <Border Grid.Column="4"
              Grid.Row="0"
              Grid.RowSpan="3"
              Classes="mfc-panel"
              Padding="10"
              ClipToBounds="True">
        <Grid>
        <!-- Inventory detail + Zones -->
        <ScrollViewer IsVisible="{Binding IsInventorySelected}"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="10" Margin="0,0,0,8">
            <TextBlock Classes="mfc-module-title" Text="Inventory detail" />
            <TextBlock Text="{Binding Inventory.SelectedNode.DetailSummary}"
                       Classes="mfc-muted" />
            <TextBlock Classes="mfc-label" Text="Workflow status" />
            <TextBlock Text="{Binding Inventory.SelectedNode.WorkflowStatusText}"
                       FontSize="18"
                       FontWeight="Bold"
                       TextWrapping="Wrap" />
            <TextBlock Classes="mfc-label" Text="Device hashes" />
            <TextBlock Text="{Binding Inventory.SelectedNode.DesiredHashText, StringFormat=desired: {0}}"
                       Classes="mfc-mono" />
            <TextBlock Text="{Binding Inventory.SelectedNode.CommittedHashText, StringFormat=committed: {0}}"
                       Classes="mfc-mono" />
            <TextBlock Text="{Binding Inventory.SelectedNode.ActualHashText, StringFormat=actual: {0}}"
                       Classes="mfc-mono" />

            <Border Classes="mfc-panel" Margin="0,12,0,0">
              <StackPanel Spacing="8">
                <TextBlock Classes="mfc-section-title" Text="Add router" />
                <TextBlock Classes="mfc-muted"
                           Text="Site → Node → Device + API-SSL credentials (RegisterDevice + UpdateDeviceConnection)." />
                <TextBlock Classes="mfc-error"
                           Text="{Binding AddRouter.ErrorText}"
                           IsVisible="{Binding AddRouter.HasError}" />
                <TextBlock Text="{Binding AddRouter.StatusText}"
                           TextWrapping="Wrap"
                           IsVisible="{Binding AddRouter.HasStatus}" />

                <TextBlock Classes="mfc-label" Text="1. Site" />
                <CheckBox Content="Use existing Site"
                          IsChecked="{Binding AddRouter.UseExistingSite}" />
                <ComboBox Classes="mfc-field"
                          ItemsSource="{Binding AddRouter.SiteChoices}"
                          SelectedItem="{Binding AddRouter.SelectedSite, Mode=TwoWay}"
                          IsVisible="{Binding AddRouter.ShowExistingSitePicker}"
                          MaxWidth="420"
                          HorizontalAlignment="Left" />
                <StackPanel Spacing="6" IsVisible="{Binding AddRouter.ShowNewSiteFields}">
                  <TextBox Classes="mfc-field" PlaceholderText="site code" Text="{Binding AddRouter.NewSiteCode}" />
                  <TextBox Classes="mfc-field" PlaceholderText="site name" Text="{Binding AddRouter.NewSiteName}" />
                </StackPanel>

                <TextBlock Classes="mfc-label" Text="2. Node" Margin="0,6,0,0" />
                <CheckBox Content="Use existing Node"
                          IsChecked="{Binding AddRouter.UseExistingNode}" />
                <ComboBox Classes="mfc-field"
                          ItemsSource="{Binding AddRouter.NodeChoices}"
                          SelectedItem="{Binding AddRouter.SelectedNode, Mode=TwoWay}"
                          IsVisible="{Binding AddRouter.ShowExistingNodePicker}"
                          MaxWidth="420"
                          HorizontalAlignment="Left" />
                <StackPanel Spacing="6" IsVisible="{Binding AddRouter.ShowNewNodeFields}">
                  <TextBox Classes="mfc-field" PlaceholderText="node name" Text="{Binding AddRouter.NewNodeName}" />
                  <ComboBox Classes="mfc-field"
                            ItemsSource="{Binding AddRouter.UplinkModes}"
                            SelectedItem="{Binding AddRouter.SelectedUplinkMode, Mode=TwoWay}"
                            MaxWidth="280"
                            HorizontalAlignment="Left" />
                </StackPanel>

                <TextBlock Classes="mfc-label" Text="3. Device" Margin="0,6,0,0" />
                <TextBlock Classes="mfc-muted"
                           Opacity="0.75"
                           Text="Optional: select a registered Device in the tree as seed, load MikroTik neighbors via Controller, then apply to pre-fill host/port. Credentials stay manual." />
                <WrapPanel Classes="mfc-toolbar" ItemSpacing="8">
                  <Button Classes="mfc-action"
                          Content="Load MikroTik neighbors"
                          Command="{Binding AddRouter.LoadNeighborsCommand}"
                          MinWidth="180"
                          IsVisible="{Binding AddRouter.CanLoadNeighborsVisible}" />
                </WrapPanel>
                <ComboBox Classes="mfc-field"
                          ItemsSource="{Binding AddRouter.NeighborCandidates}"
                          SelectedItem="{Binding AddRouter.SelectedNeighborCandidate, Mode=TwoWay}"
                          IsVisible="{Binding AddRouter.HasNeighborCandidates}"
                          MaxWidth="520"
                          HorizontalAlignment="Left">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding DisplayText}" TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Classes="mfc-action"
                        Content="Apply selected neighbor"
                        Command="{Binding AddRouter.ApplyNeighborCandidateCommand}"
                        MinWidth="180"
                        HorizontalAlignment="Left"
                        IsVisible="{Binding AddRouter.HasNeighborCandidates}" />
                <TextBox Classes="mfc-field" PlaceholderText="display name" Text="{Binding AddRouter.DeviceDisplayName}" />
                <TextBox Classes="mfc-field" PlaceholderText="management host (IP or DNS)" Text="{Binding AddRouter.ManagementHost}" />
                <TextBox Classes="mfc-field" PlaceholderText="management port (8729)" Text="{Binding AddRouter.ManagementPortText}" />

                <TextBlock Classes="mfc-label" Text="4. Connection profile" Margin="0,6,0,0" />
                <TextBox Classes="mfc-field" PlaceholderText="API username" Text="{Binding AddRouter.Username}" />
                <TextBox Classes="mfc-field"
                         PlaceholderText="API password"
                         Text="{Binding AddRouter.Password}"
                         PasswordChar="*" />
                <ComboBox Classes="mfc-field"
                          ItemsSource="{Binding AddRouter.TrustModes}"
                          SelectedItem="{Binding AddRouter.SelectedTrustMode, Mode=TwoWay}"
                          MaxWidth="280"
                          HorizontalAlignment="Left" />
                <TextBox Classes="mfc-field"
                         PlaceholderText="CA profile ref"
                         Text="{Binding AddRouter.CaProfileRef}"
                         IsVisible="{Binding AddRouter.ShowCaProfile}" />
                <TextBox Classes="mfc-field"
                         PlaceholderText="pinned SPKI SHA-256 (64 hex)"
                         Text="{Binding AddRouter.PinnedSpkiSha256Hex}"
                         IsVisible="{Binding AddRouter.ShowSpkiPin}"
                         FontFamily="Consolas,Menlo,monospace" />

                <Button Classes="mfc-action"
                        Content="Create / register"
                        Command="{Binding AddRouter.SubmitCommand}"
                        MinWidth="160"
                        HorizontalAlignment="Left"
                        Margin="0,4,0,0" />
              </StackPanel>
            </Border>

            <Border Classes="mfc-panel" Margin="0,12,0,0">
              <StackPanel Spacing="10">
                <DockPanel LastChildFill="True">
                  <WrapPanel DockPanel.Dock="Right"
                             Classes="mfc-toolbar"
                             ItemSpacing="8"
                             Margin="8,0,0,0">
                    <Button Classes="mfc-action" Content="Refresh" Command="{Binding Zones.RefreshCommand}" />
                    <Button Classes="mfc-action" Content="Resolve node" Command="{Binding Zones.ResolveCommand}" MinWidth="110" />
                  </WrapPanel>
                  <StackPanel Spacing="2">
                    <TextBlock Classes="mfc-section-title" Text="Logical zones &amp; Node bindings" />
                    <TextBlock Text="{Binding Zones.SelectedNodeHint}" Classes="mfc-muted" />
                    <TextBlock Classes="mfc-error"
                               Text="{Binding Zones.ErrorText}"
                               IsVisible="{Binding Zones.HasError}" />
                  </StackPanel>
                </DockPanel>

                <Grid ColumnDefinitions="*,12,*" RowDefinitions="Auto,Auto">
                  <Border Grid.Column="0" Grid.Row="0" Classes="mfc-panel">
                    <StackPanel Spacing="6">
                      <TextBlock Classes="mfc-label" Text="Company zones" />
                      <TextBox Classes="mfc-field" PlaceholderText="key" Text="{Binding Zones.NewZoneKey}" />
                      <TextBox Classes="mfc-field" PlaceholderText="name" Text="{Binding Zones.NewZoneName}" />
                      <TextBox Classes="mfc-field" PlaceholderText="description (optional)" Text="{Binding Zones.NewZoneDescription}" />
                      <WrapPanel Classes="mfc-toolbar" ItemSpacing="8">
                        <Button Classes="mfc-action" Content="Create" Command="{Binding Zones.CreateZoneCommand}" MinWidth="90" />
                        <Button Classes="mfc-action" Content="Delete" Command="{Binding Zones.DeleteZoneCommand}" MinWidth="90" />
                      </WrapPanel>
                      <ListBox ItemsSource="{Binding Zones.Zones}"
                               SelectedItem="{Binding Zones.SelectedZone, Mode=TwoWay}"
                               MaxHeight="220">
                        <ListBox.ItemsPanel>
                          <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                          </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                          <DataTemplate DataType="svc:ZoneDefinitionListItem">
                            <TextBlock Text="{Binding SummaryLine}" TextWrapping="Wrap" Margin="2" />
                          </DataTemplate>
                        </ListBox.ItemTemplate>
                      </ListBox>
                    </StackPanel>
                  </Border>

                  <Border Grid.Column="2" Grid.Row="0" Classes="mfc-panel">
                    <StackPanel Spacing="6">
                      <TextBlock Classes="mfc-label" Text="Node bindings" />
                      <ComboBox Classes="mfc-field"
                                ItemsSource="{Binding Zones.BindingKinds}"
                                SelectedItem="{Binding Zones.SelectedBindingKind, Mode=TwoWay}" />
                      <TextBox Classes="mfc-field" PlaceholderText="values (comma-separated)" Text="{Binding Zones.BindingValuesText}" />
                      <WrapPanel Classes="mfc-toolbar" ItemSpacing="8">
                        <Button Classes="mfc-action" Content="Upsert binding" Command="{Binding Zones.UpsertBindingCommand}" MinWidth="120" />
                        <Button Classes="mfc-action" Content="Delete binding" Command="{Binding Zones.DeleteBindingCommand}" MinWidth="120" />
                      </WrapPanel>
                      <ListBox ItemsSource="{Binding Zones.Bindings}"
                               SelectedItem="{Binding Zones.SelectedBinding, Mode=TwoWay}"
                               MaxHeight="220">
                        <ListBox.ItemsPanel>
                          <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                          </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                          <DataTemplate DataType="svc:NodeZoneBindingListItem">
                            <TextBlock Text="{Binding SummaryLine}" TextWrapping="Wrap" Margin="2" />
                          </DataTemplate>
                        </ListBox.ItemTemplate>
                      </ListBox>
                    </StackPanel>
                  </Border>

                  <TextBlock Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="1"
                             Margin="0,12,0,4" Classes="mfc-label" Text="Resolve results / blockers" />
                </Grid>
                <Border Classes="mfc-list-frame" MinHeight="120" MaxHeight="240">
                  <ListBox ItemsSource="{Binding Zones.ResolveResults}">
                    <ListBox.ItemsPanel>
                      <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                      </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                      <DataTemplate DataType="svc:ZoneResolveResultListItem">
                        <TextBlock Text="{Binding SummaryLine}" TextWrapping="Wrap" Margin="4"
                                   FontFamily="Consolas,Menlo,monospace" />
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Border>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- Node -->
        <ScrollViewer IsVisible="{Binding IsNodeSelected}"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="10" Margin="0,0,0,8">
            <DockPanel LastChildFill="True">
              <Button Classes="mfc-action"
                      Content="Refresh"
                      Command="{Binding Node.RefreshCommand}"
                      DockPanel.Dock="Right"
                      Margin="8,0,0,0" />
              <TextBlock Classes="mfc-module-title" Text="Node" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock Text="{Binding Node.SelectionHint}" Classes="mfc-muted" />
            <TextBlock Classes="mfc-label" Text="Topology" />
            <TextBlock Text="{Binding Node.TopologyText}" TextWrapping="Wrap" />
            <TextBlock Classes="mfc-label" Text="Workflow / readiness" />
            <TextBlock Text="{Binding Node.WorkflowStatusText}" FontSize="18" FontWeight="Bold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Node.DeploymentReadinessText}" Classes="mfc-muted" />
            <TextBlock Classes="mfc-label" Text="Onboarding readiness" />
            <TextBlock Text="{Binding Node.OnboardingReadinessText}" TextWrapping="Wrap" />
            <TextBlock Classes="mfc-label" Text="Zones summary" />
            <ListBox ItemsSource="{Binding Node.ZoneSummaryLines}" MaxHeight="160">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <VirtualizingStackPanel />
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
            </ListBox>
            <TextBlock Classes="mfc-label" Text="Device hashes" />
            <ListBox ItemsSource="{Binding Node.DeviceHashLines}" MaxHeight="200">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <VirtualizingStackPanel />
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
            </ListBox>

            <Border Classes="mfc-panel" Margin="0,12,0,0">
              <StackPanel Spacing="8">
                <DockPanel LastChildFill="True">
                  <Button Classes="mfc-action"
                          Content="Refresh"
                          Command="{Binding RoutingAssurance.RefreshCommand}"
                          DockPanel.Dock="Right"
                          Margin="8,0,0,0" />
                  <TextBlock Classes="mfc-label" Text="Routing assurance (read-only)" VerticalAlignment="Center" TextWrapping="Wrap" />
                </DockPanel>
                <TextBlock Text="{Binding RoutingAssurance.StatusText}" Classes="mfc-muted" />
                <TextBlock Classes="mfc-error"
                           Text="{Binding RoutingAssurance.ErrorText}"
                           IsVisible="{Binding RoutingAssurance.HasError}" />
                <TextBlock Text="{Binding RoutingAssurance.ConfigurationHashText, StringFormat=configuration_hash: {0}}"
                           Classes="mfc-mono" />
                <TextBlock Text="{Binding RoutingAssurance.OperationalHashText, StringFormat=operational_hash: {0}}"
                           Classes="mfc-mono" />
                <TextBlock Classes="mfc-label" Text="Route expectations" />
                <ListBox ItemsSource="{Binding RoutingAssurance.ExpectationLines}" MaxHeight="120">
                  <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                      <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                  </ListBox.ItemsPanel>
                </ListBox>
                <TextBlock Classes="mfc-label" Text="Route findings" />
                <ListBox ItemsSource="{Binding RoutingAssurance.FindingLines}" MaxHeight="120">
                  <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                      <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                  </ListBox.ItemsPanel>
                </ListBox>
                <TextBlock Classes="mfc-label" Text="Trace summaries" />
                <ListBox ItemsSource="{Binding RoutingAssurance.TraceSummaryLines}" MaxHeight="160">
                  <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                      <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                  </ListBox.ItemsPanel>
                </ListBox>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- Snapshots: Snapshot + Diff -->
        <TabControl IsVisible="{Binding IsSnapshotsSelected}">
          <TabItem Header="Snapshot">
            <Grid ColumnDefinitions="220,12,*" RowDefinitions="Auto,*,Auto" Margin="0,8,0,0">
              <StackPanel Grid.Column="0" Grid.Row="0" Spacing="6" Margin="0,0,0,8">
                <TextBlock Classes="mfc-section-title" Text="Sections" />
                <WrapPanel Classes="mfc-toolbar" ItemSpacing="8">
                  <CheckBox Content="Technical"
                            IsChecked="{Binding Snapshot.ShowTechnicalView}"
                            VerticalAlignment="Center" />
                  <Button Classes="mfc-action"
                          Content="Reload"
                          Command="{Binding Snapshot.ReloadCommand}" />
                </WrapPanel>
              </StackPanel>

              <Border Grid.Column="0"
                      Grid.Row="1"
                      Classes="mfc-list-frame"
                      ClipToBounds="True">
                <ListBox ItemsSource="{Binding Snapshot.VisibleSections}"
                         SelectedItem="{Binding Snapshot.SelectedSection, Mode=TwoWay}">
                  <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                      <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                  </ListBox.ItemsPanel>
                  <ListBox.ItemTemplate>
                    <DataTemplate DataType="svc:SnapshotSectionListItem">
                      <StackPanel Spacing="2" Margin="2">
                        <TextBlock Text="{Binding SectionId}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Opacity="0.75" Text="{Binding StatusText, StringFormat=Status: {0}}" />
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Border>

              <TextBlock Grid.Column="0"
                         Grid.Row="2"
                         Margin="0,8,0,0"
                         Classes="mfc-error"
                         Text="{Binding Snapshot.ErrorText}"
                         IsVisible="{Binding Snapshot.HasError}" />

              <DockPanel Grid.Column="2" Grid.Row="0" Margin="0,0,0,8" LastChildFill="True">
                <Button Classes="mfc-action"
                        Content="Copy sanitized"
                        Command="{Binding Snapshot.CopySanitizedCommand}"
                        DockPanel.Dock="Right"
                        MinWidth="120"
                        Margin="8,0,0,0" />
                <TextBlock Classes="mfc-section-title"
                           Text="Snapshot (configuration / observations)"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap" />
              </DockPanel>

              <Border Grid.Column="2"
                      Grid.Row="1"
                      Grid.RowSpan="2"
                      Classes="mfc-panel"
                      ClipToBounds="True">
                <Grid RowDefinitions="Auto,Auto,*,Auto,*,Auto">
                  <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,8">
                    <TextBlock Text="{Binding Snapshot.HintText}" Classes="mfc-muted" />
                    <TextBlock Text="{Binding Snapshot.StatusText, StringFormat=Capture status: {0}}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Snapshot.SchemaVersionText, StringFormat=Schema version: {0}}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Snapshot.ConfigurationHashText, StringFormat=configuration_hash: {0}}"
                               Classes="mfc-mono" />
                    <TextBlock Text="{Binding Snapshot.ObservationHashText, StringFormat=observation_hash: {0}}"
                               Classes="mfc-mono" />
                    <TextBlock Text="{Binding Snapshot.CapabilityHashText, StringFormat=capability_hash: {0}}"
                               Classes="mfc-mono" />
                    <ComboBox Classes="mfc-field"
                              ItemsSource="{Binding Snapshot.Captures}"
                              SelectedItem="{Binding Snapshot.SelectedCapture, Mode=TwoWay}"
                              MaxWidth="420"
                              HorizontalAlignment="Left"
                              PlaceholderText="Captures">
                      <ComboBox.ItemTemplate>
                        <DataTemplate DataType="svc:SnapshotCaptureListItem">
                          <TextBlock Text="{Binding CompletedAtText}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </StackPanel>

                  <TextBlock Grid.Row="1" Margin="0,4,0,4" Classes="mfc-label" Text="Configuration records" />
                  <ListBox Grid.Row="2"
                           ItemsSource="{Binding Snapshot.ConfigurationRecords}"
                           SelectedItem="{Binding Snapshot.SelectedConfigurationRecord, Mode=TwoWay}"
                           Margin="0,0,0,8"
                           MinHeight="100">
                    <ListBox.ItemsPanel>
                      <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                      </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                      <DataTemplate DataType="svc:SnapshotRecordListItem">
                        <TextBlock Text="{Binding SummaryLine}" TextWrapping="Wrap" Margin="2" />
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>

                  <TextBlock Grid.Row="3" Margin="0,0,0,4" Classes="mfc-label" Text="Observation records" />
                  <ListBox Grid.Row="4"
                           ItemsSource="{Binding Snapshot.ObservationRecords}"
                           SelectedItem="{Binding Snapshot.SelectedObservationRecord, Mode=TwoWay}"
                           MinHeight="80">
                    <ListBox.ItemsPanel>
                      <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                      </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                      <DataTemplate DataType="svc:SnapshotRecordListItem">
                        <TextBlock Text="{Binding SummaryLine}" TextWrapping="Wrap" Margin="2" />
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>

                  <Grid Grid.Row="5" Margin="0,8,0,0" MinHeight="96">
                    <TextBlock Classes="mfc-muted"
                               VerticalAlignment="Top"
                               Text="Select a record to see all fields."
                               IsVisible="{Binding Snapshot.HasNoSelectedRecord}" />
                    <Border Classes="mfc-list-frame"
                            ClipToBounds="True"
                            MaxHeight="220"
                            IsVisible="{Binding Snapshot.HasSelectedRecord}">
                      <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="4,2,4,6">
                          <TextBlock Classes="mfc-label" Text="Selected record fields" />
                          <TextBlock Text="{Binding Snapshot.SelectedRecordDetail.StableKey}"
                                     FontWeight="SemiBold"
                                     TextWrapping="Wrap" />
                          <TextBlock Classes="mfc-muted"
                                     Text="{Binding Snapshot.SelectedRecordDetail.DomainLabel, StringFormat=Domain: {0}}" />
                          <TextBlock Classes="mfc-muted"
                                     Text="{Binding Snapshot.SelectedRecordDetail.OrdinalText, StringFormat=Ordinal: {0}}" />
                        </StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                          <ItemsControl ItemsSource="{Binding Snapshot.SelectedRecordFields}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate DataType="svc:SnapshotFieldLine">
                                <TextBlock Text="{Binding DisplayLine}"
                                           Classes="mfc-mono"
                                           TextWrapping="Wrap"
                                           Margin="8,0,4,2" />
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </ScrollViewer>
                      </DockPanel>
                    </Border>
                  </Grid>
                </Grid>
              </Border>
            </Grid>
          </TabItem>

          <TabItem Header="Semantic diff">
            <Grid ColumnDefinitions="220,12,*" RowDefinitions="Auto,*" Margin="0,8,0,0">
              <StackPanel Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="0" Spacing="8" Margin="0,0,0,10">
                <TextBlock Classes="mfc-section-title" Text="Compare snapshots (server-side)" />
                <TextBlock Text="{Binding Diff.StatusText}" Classes="mfc-muted" />
                <WrapPanel Classes="mfc-toolbar" ItemSpacing="12">
                  <StackPanel Spacing="4" MinWidth="200" MaxWidth="360">
                    <TextBlock Text="Base" Classes="mfc-label" />
                    <ComboBox Classes="mfc-field"
                              ItemsSource="{Binding Diff.Captures}"
                              SelectedItem="{Binding Diff.BaseCapture, Mode=TwoWay}"
                              PlaceholderText="Base capture">
                      <ComboBox.ItemTemplate>
                        <DataTemplate DataType="svc:SnapshotCaptureListItem">
                          <TextBlock Text="{Binding CompletedAtText}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </StackPanel>
                  <StackPanel Spacing="4" MinWidth="200" MaxWidth="360">
                    <TextBlock Text="Target" Classes="mfc-label" />
                    <ComboBox Classes="mfc-field"
                              ItemsSource="{Binding Diff.Captures}"
                              SelectedItem="{Binding Diff.TargetCapture, Mode=TwoWay}"
                              PlaceholderText="Target capture">
                      <ComboBox.ItemTemplate>
                        <DataTemplate DataType="svc:SnapshotCaptureListItem">
                          <TextBlock Text="{Binding CompletedAtText}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </StackPanel>
                  <Button Classes="mfc-action"
                          Content="Compare"
                          Command="{Binding Diff.CompareCommand}"
                          VerticalAlignment="Bottom"
                          MinWidth="100" />
                  <Button Classes="mfc-action"
                          Content="Reload captures"
                          Command="{Binding Diff.ReloadCapturesCommand}"
                          VerticalAlignment="Bottom"
                          MinWidth="120" />
                </WrapPanel>
                <WrapPanel Classes="mfc-toolbar" ItemSpacing="16">
                  <CheckBox Content="Configuration only"
                            IsChecked="{Binding Diff.ShowConfigurationOnly}" />
                  <CheckBox Content="Observations only"
                            IsChecked="{Binding Diff.ShowObservationOnly}" />
                </WrapPanel>
                <TextBlock Text="No differences"
                           FontSize="18"
                           FontWeight="Bold"
                           IsVisible="{Binding Diff.IsNoDifferences}" />
                <TextBlock Classes="mfc-error"
                           Text="{Binding Diff.ErrorText}"
                           IsVisible="{Binding Diff.HasError}" />
                <StackPanel Spacing="4" IsVisible="{Binding Diff.HasWarnings}">
                  <TextBlock Classes="mfc-label" Text="Compare warnings" />
                  <ItemsControl ItemsSource="{Binding Diff.Warnings}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Classes="mfc-warning"
                                   Text="{Binding}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,2" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </StackPanel>

              <Border Grid.Column="0"
                      Grid.Row="1"
                      Classes="mfc-list-frame"
                      ClipToBounds="True">
                <ListBox ItemsSource="{Binding Diff.SectionGroups}"
                         SelectedItem="{Binding Diff.SelectedSectionGroup, Mode=TwoWay}">
                  <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                      <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                  </ListBox.ItemsPanel>
                  <ListBox.ItemTemplate>
                    <DataTemplate DataType="svc:SnapshotDiffSectionGroup">
                      <StackPanel Spacing="2" Margin="2">
                        <TextBlock Text="{Binding SectionId}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Opacity="0.75" Text="{Binding EntryCount, StringFormat={}{0} entries}" />
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Border>

              <Border Grid.Column="2"
                      Grid.Row="1"
                      Classes="mfc-list-frame"
                      ClipToBounds="True">
                <ListBox ItemsSource="{Binding Diff.VisibleEntries}">
                  <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                      <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                  </ListBox.ItemsPanel>
                  <ListBox.ItemTemplate>
                    <DataTemplate DataType="svc:SnapshotDiffEntryItem">
                      <StackPanel Spacing="4" Margin="4">
                        <TextBlock Text="{Binding HeaderLine}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding ConfidenceText, StringFormat=Confidence: {0}}" Opacity="0.75" />
                        <ItemsControl ItemsSource="{Binding FieldLines}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="svc:SnapshotDiffFieldLine">
                              <TextBlock Text="{Binding Summary}"
                                         Classes="mfc-muted"
                                         TextWrapping="Wrap"
                                         Margin="8,0,0,2" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Border>
            </Grid>
          </TabItem>
        </TabControl>

        <!-- Policies -->
        <ScrollViewer IsVisible="{Binding IsPoliciesSelected}"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="10">
            <StackPanel Spacing="2">
              <TextBlock Classes="mfc-section-title" Text="Policy authoring / review / binding" />
              <TextBlock Classes="mfc-warning"
                         Text="{Binding Policies.ReadOnlyBannerText}"
                         IsVisible="{Binding Policies.IsReadOnlyBannerVisible}" />
              <TextBlock Classes="mfc-error"
                         Text="{Binding Policies.ErrorText}"
                         IsVisible="{Binding Policies.HasError}" />
            </StackPanel>

            <Border Classes="mfc-panel">
              <StackPanel Spacing="6">
                <TextBlock Classes="mfc-label" Text="Revision" />
                <WrapPanel Classes="mfc-toolbar" ItemSpacing="8">
                  <TextBox Classes="mfc-field"
                           PlaceholderText="revision UUID"
                           Text="{Binding Policies.RevisionIdText}"
                           MinWidth="240"
                           Width="320" />
                  <Button Classes="mfc-action" Content="Load" Command="{Binding Policies.LoadCommand}" />
                </WrapPanel>
                <WrapPanel Classes="mfc-toolbar" ItemSpacing="8">
                  <TextBox Classes="mfc-field"
                           PlaceholderText="draft name (CompanyBaseline)"
                           Text="{Binding Policies.DraftNameText}"
                           MinWidth="240"
                           Width="320" />
                  <Button Classes="mfc-action" Content="Create draft" Command="{Binding Policies.CreateDraftCommand}" MinWidth="110" />
                </WrapPanel>
                <TextBlock Text="{Binding Policies.StateText, StringFormat=State: {0}}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Policies.ContentHashText, StringFormat=Content hash: {0}}"
                           Classes="mfc-mono" />
                <WrapPanel Classes="mfc-toolbar" ItemSpacing="8">
                  <Button Classes="mfc-action" Content="Validate" Command="{Binding Policies.ValidateCommand}" MinWidth="90" />
                  <Button Classes="mfc-action" Content="Submit for review" Command="{Binding Policies.SubmitCommand}" MinWidth="130" />
                  <Button Classes="mfc-action" Content="Approve" Command="{Binding Policies.ApproveCommand}" MinWidth="90" />
                  <Button Classes="mfc-action" Content="Bind" Command="{Binding Policies.BindCommand}" />
                  <Button Classes="mfc-action"
                          Content="Deploy"
                          Command="{Binding Policies.DeployCommand}"
                          MinWidth="90"
                          ToolTip.Tip="Deploy blocked from authoring (no Save and Deploy). Use Operations → Deploy." />
                </WrapPanel>
              </StackPanel>
            </Border>

            <Border Classes="mfc-panel">
              <StackPanel Spacing="6">
                <TextBlock Classes="mfc-label" Text="Rules" />
                <WrapPanel Classes="mfc-toolbar" ItemSpacing="8">
                  <ComboBox Classes="mfc-field"
                            ItemsSource="{Binding Policies.Families}"
                            SelectedItem="{Binding Policies.SelectedFamily, Mode=TwoWay}"
                            MinWidth="100"
                            Width="120" />
                  <ComboBox Classes="mfc-field"
                            ItemsSource="{Binding Policies.Chains}"
                            SelectedItem="{Binding Policies.SelectedChain, Mode=TwoWay}"
                            MinWidth="120"
                            Width="140" />
                  <ComboBox Classes="mfc-field"
                            ItemsSource="{Binding Policies.Stages}"
                            SelectedItem="{Binding Policies.SelectedStage, Mode=TwoWay}"
                            MinWidth="160"
                            Width="200" />
                  <ComboBox Classes="mfc-field"
                            ItemsSource="{Binding Policies.Effects}"
                            SelectedItem="{Binding Policies.SelectedEffect, Mode=TwoWay}"
                            MinWidth="120"
                            Width="160" />
                </WrapPanel>
                <TextBox Classes="mfc-field" PlaceholderText="description" Text="{Binding Policies.RuleDescriptionText}" />
                <Button Classes="mfc-action" Content="Add rule" Command="{Binding Policies.AddRuleCommand}" MinWidth="100" HorizontalAlignment="Left" />
                <ListBox ItemsSource="{Binding Policies.Rules}" MaxHeight="180">
                  <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                      <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                  </ListBox.ItemsPanel>
                  <ListBox.ItemTemplate>
                    <DataTemplate DataType="svc:PolicyRuleListItem">
                      <TextBlock Text="{Binding SummaryLine}" TextWrapping="Wrap" Margin="2"
                                 FontFamily="Consolas,Menlo,monospace" />
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </StackPanel>
            </Border>

            <Border Classes="mfc-panel">
              <StackPanel Spacing="6">
                <TextBlock Classes="mfc-label" Text="Review: compose / diff / analysis risk" />
                <WrapPanel Classes="mfc-toolbar" ItemSpacing="8">
                  <TextBox Classes="mfc-field"
                           PlaceholderText="compose node UUID"
                           Text="{Binding Policies.ComposeNodeIdText}"
                           MinWidth="240"
                           Width="320" />
                  <Button Classes="mfc-action" Content="Compose findings" Command="{Binding Policies.ComposeCommand}" MinWidth="130" />
                </WrapPanel>
                <WrapPanel Classes="mfc-toolbar" ItemSpacing="8">
                  <TextBox Classes="mfc-field"
                           PlaceholderText="baseline revision UUID"
                           Text="{Binding Policies.DiffBaselineRevisionIdText}"
                           MinWidth="240"
                           Width="320" />
                  <Button Classes="mfc-action" Content="Semantic diff" Command="{Binding Policies.DiffCommand}" MinWidth="120" />
                </WrapPanel>
                <ListBox ItemsSource="{Binding Policies.Findings}" MaxHeight="120">
                  <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                      <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                  </ListBox.ItemsPanel>
                  <ListBox.ItemTemplate>
                    <DataTemplate DataType="svc:PolicyFindingListItem">
                      <TextBlock Text="{Binding SummaryLine}" TextWrapping="Wrap" Margin="2"
                                 FontFamily="Consolas,Menlo,monospace" />
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- Operations: Onboarding + Deploy + recovery -->
        <TabControl IsVisible="{Binding IsOperationsSelected}">
          <TabItem Header="Onboarding">
            <ScrollViewer Margin="0,8,0,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
              <StackPanel Spacing="10">
                <StackPanel Spacing="2">
                  <TextBlock Classes="mfc-section-title" Text="Managed-device onboarding" />
                  <TextBlock Text="{Binding Onboarding.StatusText}" Classes="mfc-muted" />
                  <TextBlock Classes="mfc-error"
                             Text="{Binding Onboarding.ErrorText}"
                             IsVisible="{Binding Onboarding.HasError}" />
                </StackPanel>
                <WrapPanel Classes="mfc-toolbar" ItemSpacing="8">
                  <Button Classes="mfc-action" Content="Validate prerequisites" Command="{Binding Onboarding.ValidateCommand}" MinWidth="160" />
                  <Button Classes="mfc-action" Content="Create plan" Command="{Binding Onboarding.CreatePlanCommand}" MinWidth="110" />
                  <Button Classes="mfc-action" Content="Start" Command="{Binding Onboarding.StartCommand}" />
                  <Button Classes="mfc-action" Content="Rollback" Command="{Binding Onboarding.RollbackCommand}" MinWidth="90" />
                  <Button Classes="mfc-action" Content="Recovery status" Command="{Binding Onboarding.RecoveryCommand}" MinWidth="130" />
                </WrapPanel>
                <TextBlock Classes="mfc-label" Text="Prerequisite checklist" />
                <ListBox ItemsSource="{Binding Onboarding.Findings}" MaxHeight="140">
                  <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                      <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                  </ListBox.ItemsPanel>
                  <ListBox.ItemTemplate>
                    <DataTemplate DataType="svc:OnboardingFindingListItem">
                      <TextBlock Text="{Binding SummaryLine}" TextWrapping="Wrap" Margin="2"
                                 FontFamily="Consolas,Menlo,monospace" />
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Classes="mfc-label" Text="Recovery facts" />
                <TextBlock Text="{Binding Onboarding.RecoveryFactsText}"
                           Classes="mfc-mono" />
                <TextBlock Classes="mfc-label" Text="Progress" />
                <ListBox ItemsSource="{Binding Onboarding.ProgressLines}" MaxHeight="120">
                  <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                      <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                  </ListBox.ItemsPanel>
                </ListBox>
              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <TabItem Header="Deploy">
            <ScrollViewer Margin="0,8,0,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
              <StackPanel Spacing="10">
                <StackPanel Spacing="2">
                  <TextBlock Classes="mfc-section-title" Text="Safe deployment" />
                  <TextBlock Text="{Binding Deployment.StatusText}" Classes="mfc-muted" />
                  <TextBlock Classes="mfc-error"
                             Text="{Binding Deployment.ErrorText}"
                             IsVisible="{Binding Deployment.HasError}" />
                </StackPanel>
                <WrapPanel Classes="mfc-toolbar" ItemSpacing="8">
                  <Button Classes="mfc-action" Content="Create plan" Command="{Binding Deployment.CreatePlanCommand}" MinWidth="110" />
                  <Button Classes="mfc-action" Content="Start" Command="{Binding Deployment.StartCommand}" />
                  <Button Classes="mfc-action" Content="Rollback" Command="{Binding Deployment.RollbackCommand}" MinWidth="90" />
                  <Button Classes="mfc-action" Content="Recovery status" Command="{Binding Deployment.RecoveryCommand}" MinWidth="130" />
                </WrapPanel>
                <TextBlock Classes="mfc-label" Text="Semantic diff" />
                <ListBox ItemsSource="{Binding Deployment.SemanticDiffLines}" MaxHeight="100">
                  <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                      <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                  </ListBox.ItemsPanel>
                </ListBox>
                <TextBlock Classes="mfc-label" Text="Recovery facts" />
                <TextBlock Text="{Binding Deployment.RecoveryFactsText}"
                           Classes="mfc-mono" />
                <TextBlock Classes="mfc-label" Text="Progress" />
                <ListBox ItemsSource="{Binding Deployment.ProgressLines}" MaxHeight="120">
                  <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                      <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                  </ListBox.ItemsPanel>
                </ListBox>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
        </TabControl>

        <!-- Drift (no automatic fix) -->
        <Grid IsVisible="{Binding IsDriftSelected}" RowDefinitions="Auto,*,*" ClipToBounds="True">
          <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="True">
            <WrapPanel DockPanel.Dock="Right" Classes="mfc-toolbar" ItemSpacing="8" Margin="8,0,0,0">
              <Button Classes="mfc-action" Content="Refresh" Command="{Binding Drift.RefreshCommand}" />
            </WrapPanel>
            <StackPanel Spacing="2">
              <TextBlock Classes="mfc-module-title" Text="Drift" />
              <TextBlock Classes="mfc-muted"
                         Text="Read-only drift events. Restoration is via Operations → Deploy (no automatic fix)." />
              <TextBlock Text="{Binding Drift.StatusText}" Classes="mfc-muted" />
              <TextBlock Classes="mfc-error"
                         Text="{Binding Drift.ErrorText}"
                         IsVisible="{Binding Drift.HasError}" />
            </StackPanel>
          </DockPanel>
          <Border Grid.Row="1" Classes="mfc-list-frame" Margin="0,0,0,8" ClipToBounds="True">
            <ListBox ItemsSource="{Binding Drift.Events}"
                     SelectedItem="{Binding Drift.SelectedEvent, Mode=TwoWay}"
                     Name="DriftEventsList">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <VirtualizingStackPanel />
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate DataType="vm:DriftEventListItem">
                  <StackPanel Spacing="2" Margin="4">
                    <TextBlock Text="{Binding SummaryLine}" TextWrapping="Wrap" FontWeight="SemiBold" />
                    <TextBlock Opacity="0.75"
                               Text="{Binding BaselineHashText, StringFormat=baseline: {0}}"
                               FontFamily="Consolas,Menlo,monospace"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Opacity="0.75"
                               Text="{Binding ActualHashText, StringFormat=actual: {0}}"
                               FontFamily="Consolas,Menlo,monospace"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Border>
          <Border Grid.Row="2" Classes="mfc-panel" ClipToBounds="True">
            <DockPanel LastChildFill="True">
              <TextBlock DockPanel.Dock="Top" Classes="mfc-label" Text="Semantic diff" Margin="0,0,0,6" />
              <TextBox Text="{Binding Drift.SemanticDiffText}"
                       IsReadOnly="True"
                       AcceptsReturn="True"
                       TextWrapping="Wrap"
                       FontFamily="Consolas,Menlo,monospace" />
            </DockPanel>
          </Border>
        </Grid>

        <!-- Audit (read-only) -->
        <Grid IsVisible="{Binding IsAuditSelected}" RowDefinitions="Auto,*,*" ClipToBounds="True">
          <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="True">
            <WrapPanel DockPanel.Dock="Right" Classes="mfc-toolbar" ItemSpacing="8" Margin="8,0,0,0">
              <Button Classes="mfc-action" Content="Refresh" Command="{Binding Audit.RefreshCommand}" />
            </WrapPanel>
            <StackPanel Spacing="2">
              <TextBlock Classes="mfc-module-title" Text="Audit" />
              <TextBlock Classes="mfc-muted"
                         Text="Read-only append-only events (newest first). No mutate actions." />
              <TextBlock Text="{Binding Audit.StatusText}" Classes="mfc-muted" />
              <TextBlock Classes="mfc-error"
                         Text="{Binding Audit.ErrorText}"
                         IsVisible="{Binding Audit.HasError}" />
            </StackPanel>
          </DockPanel>
          <Border Grid.Row="1" Classes="mfc-list-frame" Margin="0,0,0,8" ClipToBounds="True">
            <ListBox ItemsSource="{Binding Audit.Events}"
                     SelectedItem="{Binding Audit.SelectedEvent, Mode=TwoWay}"
                     Name="AuditEventsList">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <VirtualizingStackPanel />
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate DataType="vm:AuditEventListItem">
                  <TextBlock Text="{Binding SummaryLine}" TextWrapping="Wrap" Margin="4" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Border>
          <Border Grid.Row="2" Classes="mfc-panel" ClipToBounds="True">
            <DockPanel LastChildFill="True">
              <TextBlock DockPanel.Dock="Top" Classes="mfc-label" Text="Payload (JSON)" Margin="0,0,0,6" />
              <TextBox Text="{Binding Audit.SelectedEvent.PayloadJson}"
                       IsReadOnly="True"
                       AcceptsReturn="True"
                       TextWrapping="Wrap"
                       FontFamily="Consolas,Menlo,monospace" />
            </DockPanel>
          </Border>
        </Grid>
        </Grid>
      </Border>
    </Grid>
  </DockPanel>
</Window>
