# Synthetic multi-WAN failover fixture — M1-31
# WAN1 10.255.21.0/30 primary; WAN2 10.255.22.0/30 secondary.
# Applied via testlab/chr/scripts/provision-multi-wan.sh failover (outside product adapter).
#
# /system identity set name=chr-multi-wan-failover
# /ip address add address=10.255.20.10/24 interface=ether1
# /routing table add name=wan1 fib
# /routing table add name=wan2 fib
# /ip route add dst-address=0.0.0.0/0 gateway=10.255.21.1 routing-table=wan1 distance=1
# /ip route add dst-address=0.0.0.0/0 gateway=10.255.22.1 routing-table=wan2 distance=2
# /ip firewall nat add chain=srcnat action=masquerade out-interface=wan1
# /ip firewall nat add chain=srcnat action=masquerade out-interface=wan2
# /ip firewall mangle add chain=prerouting action=mark-routing new-routing-mark=wan1
# /ip firewall mangle add chain=prerouting action=mark-routing new-routing-mark=wan2
# /ip settings set rp-filter=strict
# No secrets.
