# Synthetic routing-assurance multi-WAN / ECMP / VRF fixture — M7.1-11
# wan-primary 198.51.100.0/30; wan-backup 203.0.113.0/30; corp VRF vlan10; ECMP 10.80.0.0/16.
# Applied via testlab/chr/scripts/provision-routing-assurance.sh (outside product adapter).
#
# /system identity set name=chr-routing-assurance
# /ip address add address=10.255.50.10/24 interface=ether1
# /routing table add name=wan-primary fib
# /routing table add name=wan-backup fib
# /routing table add name=corp fib
# /ip vrf add name=corp interfaces=vlan10
# /routing rule add action=lookup routing-mark=wan-primary-mark table=wan-primary
# /routing rule add action=lookup routing-mark=wan-backup-mark table=wan-backup
# /ip route add dst-address=0.0.0.0/0 gateway=198.51.100.1 routing-table=wan-primary distance=1
# /ip route add dst-address=0.0.0.0/0 gateway=203.0.113.1 routing-table=wan-backup distance=1
# /ip route add dst-address=10.20.0.0/16 gateway=10.99.0.1 routing-table=corp distance=1
# /ip route add dst-address=10.80.0.0/16 gateway=10.0.0.2 routing-table=main distance=1
# /ip route add dst-address=10.80.0.0/16 gateway=10.0.0.3 routing-table=main distance=1
# /ip firewall mangle add chain=prerouting action=mark-routing new-routing-mark=wan-primary-mark passthrough=yes
# /ip firewall mangle add chain=prerouting action=mark-routing new-routing-mark=wan-backup-mark passthrough=yes
# /ip settings set rp-filter=strict
# No secrets.
