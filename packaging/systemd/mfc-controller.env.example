# MTDirector Controller — EnvironmentFile sample (OPS-HOST-ENV-01 / W7-294)
#
# Copy to the path referenced by packaging/systemd/mfc-controller.service:
#   EnvironmentFile=-/etc/mfc/controller.env
#
#   # Prefer OPS-HOST-SYSUSERS-01 tmpfiles for /etc/mfc, then:
#   sudo cp mfc-controller.env.example /etc/mfc/controller.env
#   sudoedit /etc/mfc/controller.env
#
# Keys use ASP.NET Core double-underscore env binding for the Mfc: section
# (prefix MFC__). Align with docs/operations/controller-configuration.md.
# NEVER put production secrets in this example file or commit real passwords/keys.
#
# Also bundled into OUT_DIR/controller/ by scripts/release/package-controller.sh.

# --- Required / commonly set ---
# PostgreSQL connection (required for Controller startup).
MFC__Database__ConnectionString=Host=127.0.0.1;Port=5432;Database=mfc;Username=mfc;Password=CHANGE_ME

# gRPC listen URL (https:// required outside Development insecure loopback).
MFC__Grpc__ListenAddress=https://0.0.0.0:5101
MFC__Grpc__ShutdownTimeoutSeconds=30
MFC__Grpc__AllowInsecureLoopback=false
# NoCertificate | AllowCertificate | RequireCertificate
MFC__Grpc__ClientCertificateMode=NoCertificate

# TLS / master-key (Production: OsKeyStore + MasterKeyBase64; Development provider forbidden outside Development).
MFC__Security__RequireTls=true
MFC__Security__MasterKeyProvider=OsKeyStore
# MFC__Security__MasterKeyBase64=

# INTERNAL_CA profiles directory + revocation mode (Online | Offline | NoCheck).
MFC__Security__TrustedCa__ProfilesDirectory=/var/lib/mfc/trusted-ca
MFC__Security__TrustedCa__RevocationMode=Online
# MFC__Security__TrustedCa__ClientCaProfileRef=

# Dev-only auth flags — keep false on production hosts.
MFC__Authentication__AllowDevelopmentAuthentication=false
MFC__Authentication__AllowMetadataActor=false

# Production operator allowlist (empty = deny-by-default). Uncomment and set actors/permissions.
# MFC__Authorization__Operators__0__Actor=desktop-operator
# MFC__Authorization__Operators__0__Permissions__0=inventory.read

# RouterOS adapters — fail-closed defaults (do not enable WriteEnabled outside controlled labs).
MFC__RouterOs__Enabled=false
MFC__RouterOs__WriteEnabled=false
MFC__RouterOs__ProbeTimeoutSeconds=30

# Optional: ASP.NET Core environment name for the host process.
# ASPNETCORE_ENVIRONMENT=Production
